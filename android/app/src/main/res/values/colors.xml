    <!-- Notification colors. Custom notification RemoteViews are rendered by
         SystemUI using the OS dark-mode setting, so every colour the ongoing
         notification draws needs a values-night counterpart (or a
         ?android:attr text colour) to stay readable when the device theme flips. -->
    <color name="noti_accent">#3A2FD1</color>
    <color name="noti_progress_fill">#3A2FD1</color>
    <color name="noti_progress_track">#33808080</color>
    <color name="noti_progress_head">#FFFFFF</color>

    <!-- Notification text. Replaces ?android:attr/textColorPrimary and
         ?android:attr/textColorSecondary: those attrs resolve against the
         inflating context's theme, which for custom RemoteViews is not
         reliably the notification shade's, so the text came out washed-out
         grey on the dark shade. These pick up values-night directly instead. -->
    <color name="noti_text_primary">#1A1A2E</color>
    <color name="noti_text_secondary">#45464F</color>
</resources>
