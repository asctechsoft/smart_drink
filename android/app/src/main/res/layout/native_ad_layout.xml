<?xml version="1.0" encoding="utf-8"?>
<!-- Bound programmatically by AppNativeAdFactory.kt — every id referenced
     there (ad_badge, ad_icon, ad_headline, ad_stars, ad_body,
     ad_call_to_action) must stay in sync with this file. -->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/native_ad_card_bg"
        android:padding="14dp">

        <TextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginBottom="8dp"
            android:background="@drawable/native_ad_badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="Ad"
            android:textColor="#0A2556"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ad_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_below="@id/ad_badge"
            android:layout_alignParentStart="true"
            android:background="@drawable/native_ad_icon_bg"
            android:scaleType="centerCrop" />

        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignTop="@id/ad_icon"
            android:layout_alignParentEnd="true"
            android:background="@drawable/native_ad_cta_bg"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textAllCaps="false"
            android:textColor="#0A2556"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/ad_icon"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@id/ad_call_to_action"
            android:layout_toEndOf="@id/ad_icon"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RatingBar
            android:id="@+id/ad_stars"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/ad_headline"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_toEndOf="@id/ad_icon"
            android:isIndicator="true"
            android:numStars="5"
            android:stepSize="0.1" />

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/ad_stars"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:layout_toEndOf="@id/ad_icon"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#B3C7F0"
            android:textSize="12sp" />

    </RelativeLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
