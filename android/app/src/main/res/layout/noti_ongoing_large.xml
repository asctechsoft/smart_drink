<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded ongoing notification content. App icon, "Drink Water" name, time and
     collapse chevron come from DecoratedCustomViewStyle (system chrome); this view
     supplies the body below the header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Amount row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="200"
            android:textColor="#FF000000"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:text="/ 1947 ml"
            android:textColor="#FF75758F"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Remaining today -->
    <TextView
        android:id="@+id/tv_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Còn 1747 ml hôm nay"
        android:textColor="#FF75758F"
        android:textSize="14sp" />

    <!-- Progress bar + percent at the right end -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_progress"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="false"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="10%"
            android:textColor="#FF3A2FD1"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Drink pill button (full width, centered) -->
    <LinearLayout
        android:id="@+id/btn_drink"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/noti_drink_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_cup_water_bar"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_btn_drink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/noti_drink"
            android:textColor="@color/clr_white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
