<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed ongoing notification content. The app icon, "Drink Water" name,
     time and expand chevron are drawn by DecoratedCustomViewStyle (system chrome);
     this view only supplies the content row below that header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Current amount -->
    <TextView
        android:id="@+id/tv_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="200"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:text="/ 1947 ml"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <!-- Divider -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="18dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#33808080"
        android:contentDescription="@null" />

    <!-- Remaining today -->
    <TextView
        android:id="@+id/tv_remaining"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:text="Còn 1747 ml hôm nay"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="13sp" />

    <!-- Drink pill button -->
    <LinearLayout
        android:id="@+id/btn_drink_small"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/noti_drink_btn"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_cup_water_bar"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_btn_drink_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/noti_drink"
            android:textColor="@color/clr_white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
